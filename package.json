    "prettier": "^3.3.3",
    "turbo": "^2.1.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.46.3"
  },
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
