# Galaxy Tools Hub Root Environment Configuration Reference
# Copy corresponding variables to apps/web/.env and apps/server/.env

NODE_ENV=development
PORT=5000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Clerk Authentication (Admin Auth Only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Zm9vLWJhci0xMy5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin/dashboard

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:3000
