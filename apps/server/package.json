{
  "name": "galaxy-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test:sprint3": "tsx src/test_sprint3.ts",
    "test:sprint4a": "tsx src/test_sprint4a.ts",
    "test:sprint4b": "tsx src/test_sprint4b.ts",
    "test:sprint4c:live": "tsx src/test_sprint4c_live.ts",
    "test:sprint4c:http": "tsx src/test_sprint4c_http.ts",
    "test:sprint5a": "tsx src/test_sprint5a.ts",
    "test:sprint5b": "tsx src/test_sprint5b.ts",
    "test:sprint7c5": "tsx src/test_sprint7c5.ts",
    "test:sprint7c5:live": "tsx src/test_sprint7c5_live.ts",
    "reservations:expire": "tsx src/scripts/expire-reservations.ts"
  },
  "dependencies": {
    "@galaxy/config": "workspace:*",
    "@galaxy/constants": "workspace:*",
    "@galaxy/types": "workspace:*",
    "@galaxy/utils": "workspace:*",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "razorpay": "^2.9.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.16.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
