# Galaxy Tools Hub Web Environment Configuration Reference
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Development value. Production must be the public HTTPS API base ending in /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Public key ID only. Never expose the Razorpay key secret or webhook secret here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
